{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor gripMotor = motor(PORT1, false);\nmotor circMotor = motor(PORT2, false);\ntouchled touch = touchled(PORT4);\nmotor kettleMotor = motor(PORT12, false);\noptical optic = optical(PORT11);\ndistance dist = distance(PORT3);\nbumper Bumper9 = bumper(PORT9);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n// Converts a color to a string\nconst char* convertColorToString(color col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\n// Convert colorType to string\nconst char* convertColorToString(colorType col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n/*----------------------------------------------------------------------------\n                                                                            \n    Module:       Noodlr               \n    Author:       Kadir Alpay, Sidhant Mehra, Alexandre McLenaghen, Andrew Saweras\n    Created:      02/11/2026                       \n    Description:  Instant Noodle Maker                        \n\nnotes:\n1. wait function was added into every while loop to fix bug where brain would give infinite loop error \n2. ternary operator was researched and used (condition ? true case : false case)\n3. researched using string library without using namespace std and when to use \".c_str\"\n4. turning optical led light on messed up color readings\n5. researched setting font because text size was too big\n6. researched \"to_string()\" in order to make a value into a string to concatenate\n7. researched setStopping(hold) so that gripper doesn't go loose after picking up packet\n8. researched convertColorToString() for printing color sensor reading\n\nto do:\n1. add comments and explanations\n2. add cook time (display)\n3. \n4. \n5. home mechanisms at beginning (configureAllSensors)\n6. implement distance sensor safety function??\n7. replace repetitive code with arrays where stated or necessary\n8. add cooking time (real)\n9. adjust for new order:\n    open and place cup\n    remove packet and place in mechanism\n    turn on kettle\n\n    wait for boil\n    pour water\n    cut packet\n    \n----------------------------------------------------------------------------*/\n\n// Include the IQ Library\n#include \"iq_cpp.h\"\n#include <string>\n\n// Allows for easier use of the VEX Library\nusing namespace vex;\n\n//prototyping\nvoid configureAllSensors(); //read the name bro.\nvoid calibration(double GRIP_ANGLE, int GRIP_SPEED, double ROTATE_ANGLE, int ROTATE_SPEED, double KETTLE_ANGLE, int KETTLE_SPEED, int KETTLE_WAIT, double GRIP_STALL); \nbool moveTo(motor& m, double target, int speed = 20, int pause = 1, int timeoutMS = 8000); //replaces the other motor functions and altBool\nbool removePacket(double GRIP_ANGLE, int GRIP_SPEED, double ROTATE_ANGLE, int ROTATE_SPEED, double GRIP_STALL);\nbool waitBoil();\nbool pourWater(double KETTLE_ANGLE, int KETTLE_SPEED, int KETTLE_WAIT);\nint safety();\nvoid show(std::string m, std::string m2 = \"\", std::string m3 = \"\", std::string m4 = \"\", std::string m5 = \"\", std::string m6 = \"\", std::string m7 = \"\", std::string m8 = \"\", std::string m9 = \"\", std::string m10 = \"\");\nint selection(std::string q, std::string op1, std::string op2, std::string op3 = \"\", std::string op4 = \"\", std::string op5 = \"\", std::string op6 = \"\", std::string op7 = \"\", std::string op8 = \"\", std::string op9 = \"\");\n\nint main() {\n  // Initializing Robot Configuration. DO NOT REMOVE!\n  vexcodeInit();\n  // Begin project code\n  configureAllSensors();\n  bool again = true;\n  const double GRIP_ANGLE = 25;\n  const int GRIP_SPEED = 10;\n  const double ROTATE_ANGLE = 30;\n  const int ROTATE_SPEED = 20;\n  const double KETTLE_ANGLE = 100;\n  const int KETTLE_SPEED = 15;\n  const int KETTLE_WAIT = 15;\n  const double GRIP_STALL = 0.5;\n\n  while(again){\n    //choose between calibration mode and regular functionality\n    if (selection(\"Choose functionality:\", \"Run Noodlr\", \"Calibration\") == 2){\n      show(\"Calibration mode selected\");\n      calibration(GRIP_ANGLE, GRIP_SPEED, ROTATE_ANGLE, ROTATE_SPEED, KETTLE_ANGLE, KETTLE_SPEED, KETTLE_WAIT, GRIP_STALL);\n    } else {\n      timer totalTime;\n      show(\"Noodlr mode selected\");\n\n      //testing\n      //waiting for boil works\n      //gripper in and out works (30 speed, 70 angle)\n      //gripper might work (calibrate)\n      //kettle pouring water works (need to calibrate for amount of water) (15 speed, 100 angle)\n\n      if (!waitBoil()){ //else if chain makes it so one failure stops everything\n        show(\"Waiting for boil failed!\");\n        again = false;\n        wait(5, seconds);\n      } else if (!removePacket(GRIP_ANGLE, GRIP_SPEED, ROTATE_ANGLE, ROTATE_SPEED, GRIP_STALL)){\n        show(\"Removing packet failed!\");\n        again = false;\n        wait(5, seconds);\n      } else if (!pourWater(KETTLE_ANGLE, KETTLE_SPEED, KETTLE_WAIT)){\n        show(\"Pouring water failed!\");\n        again = false;\n        wait(5, seconds);\n      } else {\n        timer cookTime;\n        while (cookTime.time(seconds) <= 180) wait(3, msec);\n      }\n    }\n\n    if (again){\n      if (selection(\"Run again?\", \"Yes\", \"No\", \"I love noodles\") == 2) again = false;\n    }\n  }\n  \n  Brain.programStop();\n  return EXIT_SUCCESS;\n}\n\nvoid configureAllSensors(){\n  //calibrate brain and wait\n  BrainInertial.calibrate();\n  wait(20, msec);\n  while (BrainInertial.isCalibrating()) wait(5, msec);\n  BrainInertial.resetRotation();\n  Brain.Screen.setFont(mono12);\n  show(\"Calibration Done\");\n\n  //reset motor positions\n  gripMotor.setStopping(hold);\n  gripMotor.resetPosition(); //account for drift later on?***\n  circMotor.resetPosition(); \n  kettleMotor.resetPosition();\n}\n\nvoid calibration(double GRIP_ANGLE, int GRIP_SPEED, double ROTATE_ANGLE, int ROTATE_SPEED, double KETTLE_ANGLE, int KETTLE_SPEED, int KETTLE_WAIT, double GRIP_STALL){\n  //improve calibration function so you dont need to manually adjust variables***\n  int option = 0;\n  bool again = true;\n  while (again){\n    option = selection(\"Click buttonCheck when chosen\", \"test waitBoil\", \"test removePacket\", \"test pourWater\");\n\n    if (option == 1){\n      bool repeat{true};\n\n      while(repeat){\n        int changing = selection(\"Nothing to change:\", \"Run\", \"Live sensor readout\", \"Escape\");\n        if (changing == 3) repeat = false;\n        else if (changing == 2){\n          while (!Brain.buttonCheck.pressing()){\n            show(\"Press check to escape\", \"\", \"Reading: \" + std::string(convertColorToString(optic.color())));\n            wait(100, msec);\n          }\n          while (Brain.buttonCheck.pressing()) wait(3, msec);\n        } else {\n          show(\"Running waitBoil\");\n          wait(5, seconds);\n          if (!waitBoil()){\n            show(\"waitBoil failed!\");\n            wait(5, seconds);\n          }\n        }\n      }\n    } else if (option == 2){\n      int GRIP_ANGLEdiff{0}, GRIP_SPEEDdiff{0}, ROTATE_ANGLEdiff{0}, ROTATE_SPEEDdiff{0};\n      double GRIP_STALLdiff{0};\n      bool change{true}, repeat{true};\n\n      while(repeat){\n        int changing = selection(\"Select what to change:\", \"GRIP_ANGLE: \" + std::to_string(int(GRIP_ANGLE + GRIP_ANGLEdiff)), \"GRIP_SPEED: \" + std::to_string(GRIP_SPEED + GRIP_SPEEDdiff), \"ROTATE_ANGLE: \" + std::to_string(int(ROTATE_ANGLE + ROTATE_ANGLEdiff)), \"ROTATE_SPEED: \" + std::to_string(ROTATE_SPEED + ROTATE_SPEEDdiff), \"GRIP_STALL: \" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) / 10) + \".\" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) % 10), \"Run\", \"Escape\");\n        \n        if (changing == 7){\n          repeat = false;\n        } else if (changing == 6) {\n          show(\"Running removePacket at:\", \"GRIP_ANGLE: \" + std::to_string(int(GRIP_ANGLE + GRIP_ANGLEdiff)), \"GRIP_SPEED: \" + std::to_string(GRIP_SPEED + GRIP_SPEEDdiff), \"ROTATE_ANGLE: \" + std::to_string(int(ROTATE_ANGLE + ROTATE_ANGLEdiff)), \"ROTATE_SPEED: \" + std::to_string(ROTATE_SPEED + ROTATE_SPEEDdiff), \"GRIP_STALL: \" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) / 10) + \".\" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) % 10));\n          wait(5, seconds);\n          if (!removePacket(GRIP_ANGLE + GRIP_ANGLEdiff, GRIP_SPEED + GRIP_SPEEDdiff, ROTATE_ANGLE + ROTATE_ANGLEdiff, ROTATE_SPEED + ROTATE_SPEEDdiff, GRIP_STALL + GRIP_STALLdiff)){\n            show(\"removePacket failed!\");\n            wait(5, seconds);\n          }\n        } else {\n          change = true;\n          while (change){\n            if (changing == 1){\n              show(\"Hold left to increase\", \"Hold right to decrease\", \"Press check when done\", \"GRIP_ANGLE: \" + std::to_string(int(GRIP_ANGLE + GRIP_ANGLEdiff)));\n            } else if (changing == 2){\n              show(\"Hold left to increase\", \"Hold right to decrease\", \"Press check when done\", \"GRIP_SPEED: \" + std::to_string(GRIP_SPEED + GRIP_SPEEDdiff));\n            } else if (changing == 3){\n              show(\"Hold left to increase\", \"Hold right to decrease\", \"Press check when done\", \"ROTATE_ANGLE: \" + std::to_string(int(ROTATE_ANGLE + ROTATE_ANGLEdiff)));\n            } else if (changing == 4){\n              show(\"Hold left to increase\", \"Hold right to decrease\", \"Press check when done\", \"ROTATE_SPEED: \" + std::to_string(ROTATE_SPEED + ROTATE_SPEEDdiff));\n            } else {\n              show(\"Hold left to increase\", \"Hold right to decrease\", \"Press check when done\", \"GRIP_STALL: \" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) / 10) + \".\" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) % 10));\n            }\n            while (!(Brain.buttonCheck.pressing() || Brain.buttonLeft.pressing() || Brain.buttonRight.pressing())) wait(3, msec);\n            change = !Brain.buttonCheck.pressing();\n            while (Brain.buttonLeft.pressing()){\n              if (changing == 1){\n                if (GRIP_ANGLE + GRIP_ANGLEdiff < 360) GRIP_ANGLEdiff++;\n                show(\"Hold left to increase\", \"Hold right to decrease\", \"GRIP_ANGLE: \" + std::to_string(int(GRIP_ANGLE + GRIP_ANGLEdiff)));\n              } else if (changing == 2){\n                if (GRIP_SPEED + GRIP_SPEEDdiff < 100) GRIP_SPEEDdiff++;\n                show(\"Hold left to increase\", \"Hold right to decrease\", \"GRIP_SPEED: \" + std::to_string(GRIP_SPEED + GRIP_SPEEDdiff));\n              } else if (changing == 3){\n                if (ROTATE_ANGLE + ROTATE_ANGLEdiff < 360) ROTATE_ANGLEdiff++;\n                show(\"Hold left to increase\", \"Hold right to decrease\", \"ROTATE_ANGLE: \" + std::to_string(int(ROTATE_ANGLE + ROTATE_ANGLEdiff)));\n              } else if (changing == 4){\n                if (ROTATE_SPEED + ROTATE_SPEEDdiff < 100) ROTATE_SPEEDdiff++;\n                show(\"Hold left to increase\", \"Hold right to decrease\", \"ROTATE_SPEED: \" + std::to_string(ROTATE_SPEED + ROTATE_SPEEDdiff));\n              } else {\n                if (GRIP_STALL + GRIP_STALLdiff < 5) GRIP_STALLdiff+= 0.10;\n                show(\"Hold left to increase\", \"Hold right to decrease\", \"GRIP_STALL: \" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) / 10) + \".\" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) % 10));\n              }\n              wait(100, msec);\n            }\n            while (Brain.buttonRight.pressing()){\n              if (changing == 1){\n                if (GRIP_ANGLE + GRIP_ANGLEdiff > 0) GRIP_ANGLEdiff--;\n                show(\"Hold left to increase\", \"Hold right to decrease\", \"GRIP_ANGLE: \" + std::to_string(int(GRIP_ANGLE + GRIP_ANGLEdiff)));\n              } else if (changing == 2){\n                if (GRIP_SPEED + GRIP_SPEEDdiff > 1) GRIP_SPEEDdiff--;\n                show(\"Hold left to increase\", \"Hold right to decrease\", \"GRIP_SPEED: \" + std::to_string(GRIP_SPEED + GRIP_SPEEDdiff));\n              } else if (changing == 3){\n                if (ROTATE_ANGLE + ROTATE_ANGLEdiff > 0) ROTATE_ANGLEdiff--;\n                show(\"Hold left to increase\", \"Hold right to decrease\", \"ROTATE_ANGLE: \" + std::to_string(int(ROTATE_ANGLE + ROTATE_ANGLEdiff)));\n              } else if (changing == 4){\n                if (ROTATE_SPEED + ROTATE_SPEEDdiff > 1) ROTATE_SPEEDdiff--;\n                show(\"Hold left to increase\", \"Hold right to decrease\", \"ROTATE_SPEED: \" + std::to_string(ROTATE_SPEED + ROTATE_SPEEDdiff));\n              } else {\n                if (GRIP_STALL + GRIP_STALLdiff > 0.15) GRIP_STALLdiff-= 0.1;\n                show(\"Hold left to increase\", \"Hold right to decrease\", \"GRIP_STALL: \" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) / 10) + \".\" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) % 10));\n              }\n              wait(100, msec);\n            }\n            while(Brain.buttonCheck.pressing()) wait(3, msec);\n          }\n        }\n      }\n\n      show(\"Changes to implement:\", \"GRIP_ANGLE <- \" + std::to_string(int(GRIP_ANGLE + GRIP_ANGLEdiff)), \"GRIP_SPEED <- \" + std::to_string(GRIP_SPEED + GRIP_SPEEDdiff), \"ROTATE_ANGLE <- \" + std::to_string(int(ROTATE_ANGLE + ROTATE_ANGLEdiff)), \"ROTATE_SPEED <- \" + std::to_string(ROTATE_SPEED + ROTATE_SPEEDdiff), \"GRIP_STALL <- \" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) / 10) + \".\" + std::to_string(int(10*(GRIP_STALL + GRIP_STALLdiff) + 0.5) % 10));\n      while (!Brain.buttonCheck.pressing()) wait(3, msec);\n      while (Brain.buttonCheck.pressing()) wait(3, msec);\n    } else if (option == 3){\n\n    } else if (option == 4){\n\n    } else if (option == 5){\n\n    } else {\n\n    }\n\n    if (selection(\"Done with calib?\", \"Yes\", \"No\") == 1) again = false;\n  }\n}\n\nbool moveTo(motor& m, double target, int speed, int pause, int timeoutMS){\n  timer t;\n\n  if (target > m.position(degrees)){\n    m.spin(forward, speed, percent);\n    t.clear();\n    while (target > m.position(degrees) && t.time(msec) < timeoutMS) wait(3, msec);\n  } else {\n    m.spin(reverse, speed, percent);\n    t.clear();\n    while (target < m.position(degrees) && t.time(msec) < timeoutMS) wait(3, msec);\n  }\n\n  bool status = t.time(msec) < timeoutMS;\n  m.stop();\n  wait(pause, seconds);\n  return status;\n}\n\nbool removePacket(double GRIP_ANGLE, int GRIP_SPEED, double ROTATE_ANGLE, int ROTATE_SPEED, double GRIP_STALL){\n  show(\"Removing packet...\");\n\n  if (!moveTo(circMotor, ROTATE_ANGLE, ROTATE_SPEED)) return false; //grip into\n  if (!moveTo(gripMotor, GRIP_ANGLE, GRIP_SPEED)) return false; //grip open\n\n  //stall detection for gripper close since this is abnormal motor use case\n  gripMotor.spin(reverse, GRIP_SPEED, percent);\n  double last = gripMotor.position(degrees);\n  wait(300, msec); //extra time for initial movement\n  double now = gripMotor.position(degrees);\n  while (gripMotor.position(degrees) > 0 && last - now >= GRIP_STALL){\n    last = now;\n    wait(100, msec);\n    now = gripMotor.position(degrees);\n  }\n  gripMotor.stop();\n  wait(1, seconds);\n\n  if (!moveTo(circMotor, 0, ROTATE_SPEED)) return false; //grip out of\n\n  show(\"Packet removed\");\n  return true;\n}\n\nbool waitBoil(){\n  int counter{0};\n  while (!(optic.color() == blue || optic.color() == cyan)){ //check if kettle was even turned on or maybe sensor is malfunctioning\n    if (counter == 0) show(\"1. Turn on kettle\", \"2. Then click buttonCheck\");\n    else if(counter >= 3) return false;\n    else show(\"Light not detected!\", \"\", \"1. Turn on kettle\", \"2. Then click buttonCheck\");\n    counter++;\n    while (!Brain.buttonCheck.pressing()) wait(3, msec);\n    while (Brain.buttonCheck.pressing()) wait(3, msec);\n  }\n\n  show(\"Waiting for boil...\");\n  wait(1, seconds);\n  timer t; //with timeout of 180 seconds\n  int notBlue = 0;\n  while (notBlue < 3 && t.time(seconds) < 180){ //triple check as safety\n    notBlue = (optic.color() == blue || optic.color() == cyan) ? 0 : notBlue + 1;\n    wait(100, msec);\n  }\n  if (notBlue < 3) return false; //timed out because kettle didnt boil in time\n\n  show(\"Water has boiled\");\n\n  wait(1, seconds);\n  return true;\n}\n\nbool pourWater(double KETTLE_ANGLE, int KETTLE_SPEED, int KETTLE_WAIT){ //add --- ? what does tis comment mean idk add what?\n  bool failed = false;\n  show(\"Pouring water...\");\n\n  if (moveTo(kettleMotor, KETTLE_ANGLE, KETTLE_SPEED)) { //if kettle tips stalls and falls it skips this and tries picking it back up\n    wait(KETTLE_WAIT, seconds);\n    show(\"Water poured\", \"Raising kettle...\");\n  } else {\n    failed = true;\n  }\n  \n\n  if (!moveTo(kettleMotor, 0, KETTLE_SPEED)){ //try to untip kettle if fails\n    if (!moveTo(kettleMotor, 0, 100)){\n      show(\"Failed to untip kettle\", \"Please manually untip kettle!\", \"Then click buttonCheck\");\n      while (!Brain.buttonCheck.pressing()) wait(3, msec);\n      while (Brain.buttonCheck.pressing()) wait(3, msec);\n    }\n    return false;\n  }\n  \n  if (failed) return false;\n\n  show(\"Kettle Raised\");\n\n  wait(1, seconds);\n  return true;\n}\n\nint safety(){\n  return 1;\n}\n\nvoid show(std::string m, std::string m2, std::string m3, std::string m4, std::string m5, std::string m6, std::string m7, std::string m8, std::string m9, std::string m10){\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1,1);\n  Brain.Screen.print(m.c_str());\n  Brain.Screen.newLine();\n  Brain.Screen.print(m2.c_str());\n  Brain.Screen.newLine();\n  Brain.Screen.print(m3.c_str());\n  Brain.Screen.newLine();\n  Brain.Screen.print(m4.c_str());\n  Brain.Screen.newLine();\n  Brain.Screen.print(m5.c_str());\n  Brain.Screen.newLine();\n  Brain.Screen.print(m6.c_str());\n  Brain.Screen.newLine();\n  Brain.Screen.print(m7.c_str());\n  Brain.Screen.newLine();\n  Brain.Screen.print(m8.c_str());\n  Brain.Screen.newLine();\n  Brain.Screen.print(m9.c_str());\n  Brain.Screen.newLine();\n  Brain.Screen.print(m10.c_str());\n}\n\nint selection(std::string q, std::string op1, std::string op2, std::string op3, std::string op4, std::string op5, std::string op6, std::string op7, std::string op8, std::string op9){\n  int choice{1}, max{9};\n  bool loop{true};\n  if (op9 == \"\") max--;\n  if (op8 == \"\") max--;\n  if (op7 == \"\") max--;\n  if (op6 == \"\") max--;\n  if (op5 == \"\") max--;\n  if (op4 == \"\") max--;\n  if (op3 == \"\") max--;\n\n  while(loop){\n    if (choice == 1){ //make this an array to reduce repetition***\n      show(q, \"> \" + op1, op2, op3, op4, op5, op6, op7, op8, op9);\n    } else if (choice == 2){\n      show(q, op1, \"> \" + op2, op3, op4, op5, op6, op7, op8, op9);\n    } else if (choice == 3){\n      show(q, op1, op2, \"> \" + op3, op4, op5, op6, op7, op8, op9);\n    } else if (choice == 4){\n      show(q, op1, op2, op3, \"> \" + op4, op5, op6, op7, op8, op9);\n    } else if (choice == 5){\n      show(q, op1, op2, op3, op4, \"> \" + op5, op6, op7, op8, op9);\n    } else if (choice == 6){\n      show(q, op1, op2, op3, op4, op5, \"> \" + op6, op7, op8, op9);\n    } else if (choice == 7){\n      show(q, op1, op2, op3, op4, op5, op6, \"> \" + op7, op8, op9);\n    } else if (choice == 8){\n      show(q, op1, op2, op3, op4, op5, op6, op7, \"> \" + op8, op9);\n    } else {\n      show(q, op1, op2, op3, op4, op5, op6, op7, op8, \"> \" + op9);\n    }\n\n    while (!(Brain.buttonCheck.pressing() || Brain.buttonLeft.pressing() || Brain.buttonRight.pressing())) wait(3, msec);\n    loop = !Brain.buttonCheck.pressing();\n    if (Brain.buttonLeft.pressing()) choice--;\n    if (choice < 1) choice = max;\n    if (Brain.buttonRight.pressing()) choice++;\n    if (choice > max) choice = 1;\n    while (Brain.buttonCheck.pressing() || Brain.buttonLeft.pressing() || Brain.buttonRight.pressing()) wait(3,msec);\n  }\n  \n  return choice;\n}\n\n// Legacy Code\n/*\nvoid altBool(bool &x); //alternates the value of a bool variable\nvoid gripper(bool &open); //opens(false) or closes(true) gripper\nvoid rotate(bool &into); //rotates gripper motor into(true) or out of(false) cup\nvoid tipKettle(bool &pour); //tips (true) or untips (false) kettle\n*/\n\n\n//variables\n//bool into = true; //gripper starts outside of cup\n//bool open = true; //gripper starts closed\n//bool pour = true; //kettle starts untilted\n\n\n/*take out packets\nrotate(into);\ngripper(open);\ngripper(open);\nrotate(into);\ngripper(open);\ngripper(open);\n\n//make some way to turn on kettle\ntipKettle(pour);\naltBool(pour); //need to continue tipping forward so set this back\n\n//wait for boil\noptic.setLight(ledState::on);\nwait(1, seconds);\nwhile (optic.color() == blue || optic.color() == cyan) wait(3, msec);\noptic.setLight(ledState::off);\n\n//pour water\ntipKettle(pour);\nwait(10, seconds);\ntipKettle(pour);\n*/\n\n\n/*\nvoid altBool(bool &x){\n  x = x ? false : true;\n}\n\nvoid gripper(bool &open){\n  if (open){\n    gripMotor.spin(forward, 10, percent);\n    while (gripMotor.position(degrees) < GRIP_ANGLE) wait(3, msec);\n    gripMotor.stop();\n  } else{\n    gripMotor.spin(reverse, 10, percent);\n    while (gripMotor.position(degrees) > 0) wait(3, msec);\n    gripMotor.stop();\n  }\n  altBool(open);\n  wait(1, seconds);\n}\n\nvoid rotate(bool &into){\n  if (into){\n    circMotor.spin(forward, 10, percent);\n    while (circMotor.position(degrees) < ROTATE_ANGLE) wait(3, msec);\n    circMotor.stop();\n  } else{\n    circMotor.spin(reverse, 10, percent);\n    while (circMotor.position(degrees) > 0) wait(3, msec);\n    circMotor.stop();\n  }\n  altBool(into);\n  wait(1, seconds);\n}\n\nvoid tipKettle(bool &pour){\n  if (pour){\n    kettleMotor.spin(forward, 100, percent);\n    while (kettleMotor.position(degrees) < KETTLE_ANGLE) wait(3, msec);\n    kettleMotor.stop();\n  } else{\n    kettleMotor.spin(reverse, 10, percent);\n    while (kettleMotor.position(degrees) > 0) wait(3, msec);\n    kettleMotor.stop();\n  }\n  altBool(pour);\n  wait(3, seconds);\n}\n*/","textLanguage":"cpp","robotConfig":[{"port":[1],"name":"gripMotor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[2],"name":"circMotor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[4],"name":"touch","customName":true,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22},{"port":[12],"name":"kettleMotor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[11],"name":"optic","customName":true,"deviceType":"Optical","deviceClass":"optical","setting":{},"triportSourcePort":22},{"port":[3],"name":"dist","customName":true,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22},{"port":[9],"name":"Bumper9","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}